%!
% ---- cidfmap.local: GBK-byte BaseFont 显式映射到自定义 TrueType 字体 ----
% 本文件由 cups-web 项目维护（docker-fonts/cidfmap.local），构建时 COPY 到容器中。
% 通过 `pdf_normalize.go` 里 gs 命令行的 `-I/etc/ghostscript` + `.runlibfile` 显式加载。
%
% 映射命中后 gs pdfwrite 生成的 PDF 里对应字体会走这里指定的字形，而不是
% 默认的 DroidSansFallback（唯一无衬线字重）。
%
% 策略说明：使用 docker-fonts/ 目录中的 Windows 原版 TrueType 字体（simsun/simhei/simkai/simfang），
% 这些是单字重字库，Bold 变体映射到与 Regular 相同的字体文件，保持字形风格一致——
% 虽然没有真正的粗体字重，但 PDF 渲染器可根据 FontDescriptor 中的 StemV/Weight 信息
% 做合成加粗（synthetic bold），这比映射到完全不同风格的字体（如宋体 Bold → 黑体）要好得多。
% 字体文件在构建时被 COPY 到 /usr/share/fonts/truetype/custom/ 目录。

% 宋体 (CB CE CC E5)
/#cb#ce#cc#e5 << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/#cb#ce#cc#e5,Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% 黑体 (BA DA CC E5)
/#ba#da#cc#e5 << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simhei.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/#ba#da#cc#e5,Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simhei.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% 楷体 (BF AC CC E5)
/#bf#ac#cc#e5 << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simkai.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/#bf#ac#cc#e5,Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simkai.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% 仿宋 (B7 C2 CB CE)
/#b7#c2#cb#ce << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simfang.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/#b7#c2#cb#ce,Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simfang.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% ═══════════════════════════════════════════════════════════════
% Adobe 标准 CJK Type0 CIDFont 名称映射（电子发票/ Acrobat 导出）
% ═══════════════════════════════════════════════════════════════
% 中国税务局电子发票系统使用 Adobe 标准 CJK 字体名（STSong-Light 等），
% 与上面的 GBK 字节编码名称是两套完全不同的命名体系。GS 遇到未映射的
% CIDFont 名时会走默认替换路径，导致金额、数字等字段乱码或重叠。
%
% 映射策略：Adobe 标准 CJK 字体名 → docker-fonts/ 中的 Windows 原版 TTF。
% Bold 变体统一映射到同款 Regular 字体文件（GS 会做 synthetic bold）。

% ── 宋体 (STSong) ──
/STSong-Light << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STSong-Regular << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STSong-Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% ── 黑体 (STHeiti) ──
/STHeiti-Light << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simhei.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STHeiti-Regular << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simhei.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STHeiti-Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simhei.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% ── 仿宋 (STFangsong) ──
/STFangsong << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simfang.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STFangsong-Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simfang.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% ── 楷体 (STKaiti) ──
/STKaiti << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simkai.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STKaiti-Bold << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simkai.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;

% ── 华文系列 (常见于 WPS/金山导出) ──
/STZhongsong << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STXingkai << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simkai.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
/STXinwei << /FileType /TrueType /Path (/usr/share/fonts/truetype/custom/simsun.ttf) /SubfontID 0 /CSI [(GB1) 2] >> ;
